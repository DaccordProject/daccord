<?xml version="1.0" encoding="utf-8"?>
<package xmlns="http://schemas.microsoft.com/packaging/2015/06/nuspec.xsd">
  <metadata>
    <id>daccord</id>
    <version>@@VERSION@@</version>
    <title>Daccord</title>
    <authors>The Daccord Project</authors>
    <projectUrl>https://github.com/DaccordProject/daccord</projectUrl>
    <licenseUrl>https://github.com/DaccordProject/daccord/blob/@@TAG@@/LICENSE</licenseUrl>
    <requireLicenseAcceptance>false</requireLicenseAcceptance>
    <projectSourceUrl>https://github.com/DaccordProject/daccord</projectSourceUrl>
    <bugTrackerUrl>https://github.com/DaccordProject/daccord/issues</bugTrackerUrl>
    <tags>chat messaging voice video communities</tags>
    <summary>Chat, voice, video, and screen sharing for Daccord communities</summary>
    <description>Daccord connects to Accord servers for community messaging, voice, video, and screen sharing. This package installs the x64 Windows application.</description>
    <releaseNotes>https://github.com/DaccordProject/daccord/releases/tag/@@TAG@@</releaseNotes>
  </metadata>
  <files><file src="tools\**" target="tools" /></files>
</package>
